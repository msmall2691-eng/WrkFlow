# Workflow Studio — environment variables
# Copy to .env.local and fill in. Both backends are optional; the contact
# form degrades gracefully if neither is configured (submissions are logged).

# --- Supabase (stores contact submissions) ---
# Server-side only. Use the service role key so inserts bypass RLS from the API route.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email-on-submit notification) ---
RESEND_API_KEY=
# Where new lead notifications are delivered.
CONTACT_NOTIFY_TO=
# Verified sender address/domain in Resend.
CONTACT_NOTIFY_FROM=onboarding@resend.dev
