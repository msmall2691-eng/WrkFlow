# Workflow Studio — environment variables
# Copy to .env.local and fill in. Both backends are optional; the contact
# form degrades gracefully if neither is configured (submissions are logged).

# --- Supabase (stores every lead) ---
# The publishable (anon) key is used. The `leads` table has an RLS policy
# granting anon INSERT-only on valid rows, so this key is safe to expose and
# can never read leads back (read them in the Supabase dashboard).
#
# This is the system of record: the contact form, the questionnaire and the
# free-tool email capture all write here BEFORE sending any email, so a Gmail
# outage or a missing credential can no longer lose a lead. Apply
# supabase/schema.sql to the project before deploying. If these are unset the
# forms still work, but email becomes the only copy again.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Gmail (email-on-submit notification) ---
# Sends through your Gmail account over SMTP. Requires 2-Step Verification on
# the account, then a Google "App Password" (https://myaccount.google.com/apppasswords).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Where new lead notifications are delivered. Defaults to GMAIL_USER if unset.
# (The code reads CONTACT_TO — an older name, CONTACT_NOTIFY_TO, was documented
# here by mistake and was never read by anything.)
CONTACT_TO=

# --- Anthropic (AI concept previews on the intake form) ---
# Optional. When set, the intake form offers to draft three visual homepage
# concepts from the visitor's answers (app/api/preview/route.ts). Each
# generation makes three Claude calls, so the route is tightly rate-limited.
# Leave unset to hide the feature entirely — the form works without it.
ANTHROPIC_API_KEY=

# --- Booking (the "Book a free 15-min call" CTA) ---
# A public scheduler URL — Cal.com, a Google appointment schedule, anything
# https. Every call CTA points at it and opens it in a new tab. Leave it unset
# and those CTAs fall back to scrolling to the contact form, which is what they
# did before; nothing breaks either way.
NEXT_PUBLIC_BOOKING_URL=

# --- Shop: Instant downloads on /marketplace (see docs/SHOP.md) ---
# Until STRIPE_SECRET_KEY and a product's price id are set, that product shows
# "Coming soon" and no Buy button. Use test-mode keys (sk_test_...) first.
STRIPE_SECRET_KEY=
# Stripe Managed Payments: Stripe is merchant of record and handles sales tax.
# On by default; set to 0 to sell under your own account with no Managed Payments.
STRIPE_MANAGED_PAYMENTS=1
# One Stripe Price id per product (price_...). Create them in the Dashboard.
STRIPE_PRICE_QUOTE_CALCULATOR=
STRIPE_PRICE_TURNOVER_CHECKLIST=
STRIPE_PRICE_WELCOME_BOOK_TEMPLATE=
# Signs download links. Any random string of 32+ characters, e.g. `openssl rand -hex 32`.
SHOP_DOWNLOAD_SECRET=
